<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.calendar.apple-google-sync</string>

    <key>ProgramArguments</key>
    <array>
        <!-- 아래 두 줄을 맥북의 Python 3.10 경로로 수정하세요 -->
        <string>/usr/local/bin/python3.10</string>
        <string>/Users/YOUR_USER/calendar-sync/sync_daemon.py</string>
        <string>-c</string>
        <string>/Users/YOUR_USER/calendar-sync/config.yaml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USER/calendar-sync</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/calendar-sync/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/calendar-sync/launchd.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
